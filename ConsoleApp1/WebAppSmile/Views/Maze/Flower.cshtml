@{
    Layout = "_MazeLayout";
    ViewData["Title"] = "Flower Cell";
}

<div class="dungeon">

    <div class="dungeon__haze"></div>
    <div class="dungeon__embers"></div>


    <header class="dungeon__header">
        <p class="dungeon__brand">Хроники лабиринта</p>

        <h1 class="dungeon__title">
            🌸 Flower Cell
        </h1>

        <p class="dungeon__tagline">
            Редкий магический источник жизни среди каменных стен.
        </p>
    </header>


    <section class="hud__panel flower-card">

        <div class="flower-symbol">
            🌺
        </div>


        <h2 class="hud__heading">
            Магический цветок лабиринта
        </h2>


        <p>
            В лабиринте встречаются клетки Flower.
            Они позволяют герою собрать магические цветы.
        </p>


        <h2 class="hud__heading">
            Правила находки
        </h2>


        <ul class="flower-rules">

            <li>
                🌸 Максимальный запас:
                <strong>3 магических цветка</strong>
            </li>


            <li>
                ✨ Если у героя меньше 3 цветов —
                клетка отображает запас магических цветов 🌸.
            </li>


            <li>
                🍃 После сбора магического цветка 🌸 клетка превращается
                в обычную землю.
            </li>


            <li>
                🔒 Можно собрать только 3 магических цветка 🌸.
            </li>


        </ul>


        <a href="/Maze" class="btn-torch">
            ← Вернуться в лабиринт
        </a>

    </section>

</div>l>