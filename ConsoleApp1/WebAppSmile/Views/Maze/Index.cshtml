@model IReadOnlyList<WebAppSmile.Models.CellTypeInfo>
@{
    Layout = "_MazeLayout";
    ViewData["Title"] = "Лабиринт";
}

<div class="dungeon">
    <div class="dungeon__haze" aria-hidden="true"></div>
    <div class="dungeon__embers" aria-hidden="true"></div>

    <header class="dungeon__header">
        <p class="dungeon__brand">Наш Атмосферный Лабиринт</p>
        <h1 class="dungeon__title">Лабиринт</h1>
        <p class="dungeon__tagline">Те же правила. Другой свет факелов.</p>
    </header>

    <div class="dungeon__stage">
        <aside class="hud">
            <div class="hud__panel">
                <h2 class="hud__heading">Герой</h2>
                <ul class="hud__stats">
                    <li><span>Здоровье</span> <strong id="stat-health">—</strong></li>
                    <li>
                        <span>
                            <a asp-controller="Maze" asp-action="CellInfo" asp-route-type="Coin">Монеты</a>
                        </span>
                        <strong id="stat-coins">—</strong>
                    </li>
                    <li><span>Зелья</span> <strong id="stat-potions">—</strong></li>
                    <li><span>Песок</span> <strong id="stat-sand">—</strong></li>
                    <li><span>Цветы</span> <strong id="stat-flowers">—</strong></li>
                </ul>
                <p class="hud__seed">Сид: <span id="stat-seed">—</span></p>
            </div>

            <div class="hud__panel hud__panel--controls">
                <h2 class="hud__heading">Ход</h2>
                <div class="dpad" role="group" aria-label="Управление">
                    <button type="button" class="dpad__btn" data-move="up" aria-label="Вверх">↑</button>
                    <div class="dpad__row">
                        <button type="button" class="dpad__btn" data-move="left" aria-label="Влево">←</button>
                        <button type="button" class="dpad__btn" data-move="down" aria-label="Вниз">↓</button>
                        <button type="button" class="dpad__btn" data-move="right" aria-label="Вправо">→</button>
                    </div>
                </div>
                <p class="hud__hint">WASD или стрелки</p>
                <button type="button" class="btn-torch" id="btn-new-game">Новый лабиринт</button>
            </div>
        </aside>

        <section class="maze-board-wrap">
            <div id="maze-board" class="maze-board" role="grid" aria-label="Поле лабиринта"></div>
            <div id="maze-overlay" class="maze-overlay" hidden>
                <p id="maze-overlay-text" class="maze-overlay__text"></p>
                <button type="button" class="btn-torch" id="btn-overlay-restart">Войти снова</button>
            </div>
        </section>

        <aside class="chronicle">
            <h2 class="hud__heading">Хроника</h2>
            <ol id="message-log" class="chronicle__list"></ol>
        </aside>
    </div>

    <section class="cell-codex" aria-labelledby="codex-heading">
        <div class="cell-codex__intro">
            <p class="cell-codex__eyebrow">Свиток подземелья</p>
            <h2 id="codex-heading" class="cell-codex__title">Кодекс ячеек</h2>
            <p class="cell-codex__lead">
                Выберите тип клетки — откроется страница с подробным описанием.
                Пока это placeholder: механика появится позже.
            </p>
        </div>

        <ul class="cell-codex__grid">
            @foreach (var cell in Model)
            {
                <li>
                    @* у клетки Diamond своя отдельная страница*@
                    @if (cell.TypeKey == "Diamond")
                    {
                        @* Это клетка Diamond — ссылка ведёт на страницу /Maze/Diamond *@
                        <a class="cell-codex__card"
                           asp-controller="Maze"
                           asp-action="Diamond">
                            <span class="cell-codex__glyph" aria-hidden="true">
                                <svg viewBox="0 0 32 32">
                                    <use href="#icon-@cell.TypeKey"></use>
                                </svg>
                            </span>
                            <span class="cell-codex__meta">
                                <span class="cell-codex__category">@cell.Category</span>
                                <span class="cell-codex__name">@cell.TitleRu</span>
                                <span class="cell-codex__teaser">@cell.Teaser</span>
                            </span>
                            <span class="cell-codex__cta">Подробнее →</span>
                        </a>
                    }
                    else
                    {
                         <a class="cell-codex__card"
                           asp-controller="Maze"
                           asp-action="CellInfo"
                           asp-route-type="@cell.TypeKey">
                            <span class="cell-codex__glyph" aria-hidden="true">
                                <svg viewBox="0 0 32 32">
                                    <use href="#icon-@cell.TypeKey"></use>
                                </svg>
                            </span>
                            <span class="cell-codex__meta">
                                <span class="cell-codex__category">@cell.Category</span>
                                <span class="cell-codex__name">@cell.TitleRu</span>
                                <span class="cell-codex__teaser">@cell.Teaser</span>
                            </span>
                            <span class="cell-codex__cta">Подробнее →</span>
                        </a>
                    }
                </li>
            }
        </ul>
    </section>
</div>

<partial name="_MazeSprites" />

@section Scripts {
    <script src="~/js/maze.js" asp-append-version="true"></script>
}