@model WebAppSmile.Models.CellTypeInfo
@{
    Layout = "_MazeLayout";
    ViewData["Title"] = Model.TitleRu;

    var currencyRate = ViewBag.CurrencyRate as CurrencyRateDto;
    var doorPrice = MazeConsole.MazeModels.Cells.PaidDoor.DOOR_PRICE;
}

<div class="dungeon dungeon--codex">
    <div class="dungeon__haze" aria-hidden="true"></div>
    <div class="dungeon__embers" aria-hidden="true"></div>

    <header class="dungeon__header">
        <p class="dungeon__brand">Кодекс ячеек</p>
        <h1 class="dungeon__title">@Model.TitleRu</h1>
        <p class="dungeon__tagline">@Model.Category</p>
    </header>

    <article class="cell-dossier">
        <div class="cell-dossier__seal">
            <svg class="cell-dossier__icon" viewBox="0 0 32 32" aria-hidden="true">
                <use href="#icon-@Model.TypeKey"></use>
            </svg>
        </div>

        <div class="cell-dossier__body">
            <p class="cell-dossier__badge">Gold rate</p>
            <h2 class="cell-dossier__heading">@Model.TitleRu</h2>
            <p class="cell-dossier__teaser">@Model.Teaser</p>

@if (currencyRate is not null)
{
    var totalPrice = doorPrice * currencyRate.Rate;

    <div class="cell-dossier__placeholder">
        <p>
            Дверь закрыта. Стоимость прохода: <strong>@doorPrice монеты</strong>
        </p>
        <p>
            В этой лавке монеты считаются золотыми
        </p>
        <p>
            Текущий курс: <strong>1 золотая монета = @currencyRate.Rate @currencyRate.Quote</strong>
        </p>
        <p>
            Итого за проход: <strong>@totalPrice @currencyRate.Quote</strong>
        </p>
    </div>
}

            <a class="btn-torch cell-dossier__back" asp-controller="Maze" asp-action="Index">← К лабиринту</a>
        </div>
    </article>
</div>

<partial name="_MazeSprites" />
