@model WebAppSmile.Models.CellTypeInfo
@{
    Layout = "_MazeLayout";
    ViewData["Title"] = Model.TitleRu;

    var currencyRate = ViewBag.CurrencyRate as CurrencyRateDto;
    var doorPrice = MazeConsole.MazeModels.Cells.PaidDoor.DOOR_PRICE;
}

<div class="dungeon dungeon--codex">
    <div class="dungeon__haze" aria-hidden="true"></div>
    <div class="dungeon__embers" aria-hidden="true"></div>

    <header class="dungeon__header">
        <p class="dungeon__brand">Кодекс ячеек</p>
        <h1 class="dungeon__title">@Model.TitleRu</h1>
        <p class="dungeon__tagline">@Model.Category</p>
    </header>

    <article class="cell-dossier">
        <div class="cell-dossier__seal">
            <svg class="cell-dossier__icon" viewBox="0 0 32 32" aria-hidden="true">
                <use href="#icon-@Model.TypeKey"></use>
            </svg>
        </div>

        <div class="cell-dossier__body">
            <p class="cell-dossier__badge">Gold rate</p>
            <h2 class="cell-dossier__heading">@Model.TitleRu</h2>
            <p class="cell-dossier__teaser">@Model.Teaser</p>

@if (currencyRate is not null)
{
    var totalPrice = doorPrice * currencyRate.Rate;

    <div class="cell-dossier__placeholder">
        <p>
            Дверь закрыта. Стоимость прохода: <strong>@doorPrice монеты</strong>
        </p>
        <p>
            В этой лавке монеты считаются золотыми
        </p>
        <p>
            Текущий курс: <strong>1 золотая монета = @currencyRate.Rate @currencyRate.Quote</strong>
        </p>
        <p>
            Итого за проход: <strong>@totalPrice @currencyRate.Quote</strong>
        </p>
    </div>
}
            @if (Model.TypeKey == "Flower")
            {
                <div class="cell-dossier__placeholder">

                    <h3> 🌸  Правила находки :</h3>

                    <ul class="flower-rules">
                        <li>
                            Максимальный запас:
                            <strong>3 магических цветка</strong>.
                        </li>

                        <li>
                            ✨ Если у героя меньше <strong>3</strong> цветов,
                            при наступании на клетку количество магических цветов
                            увеличится на <strong>1</strong>.
                        </li>

                        <li>
                            🍃 После сбора магического цветка 
                            клетка превращается в обычную землю.
                        </li>

                        <li>
                            🔒 Если у героя уже <strong>3</strong> цветка,
                            новый цветок остается на карте.
                        </li>
                    </ul>

                    @if (ViewBag.Flower != null)
                    {
                        <div class="api-block">

                            <h3>
                                🌸 Твой магический цветок :
                            </h3>

                            <p>
                                <strong>Название:</strong>
                                @ViewBag.Flower.canonicalName
                            </p>

                            <p>
                                <strong>Род:</strong>
                                @ViewBag.Flower.genus
                            </p>

                        </div>
                    }


                    <h3> 🌸 Результаты игры:</h3>

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Старт</th>
                                <th>Финиш</th>
                                <th>Игрок</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>0</td>
                                <td>1</td>
                                <td>Ваня</td>
                            </tr>

                            <tr>
                                <td>1</td>
                                <td>2</td>
                                <td>Рома</td>
                            </tr>

                            <tr>
                                <td>2</td>
                                <td>3</td>
                                <td>Лилия</td>
                            </tr>

                            <tr>
                                <td>3</td>
                                <td>3</td>
                                <td>Света</td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            }
            <div class="cell-dossier__placeholder" role="status">
                <span class="cell-dossier__ornament" aria-hidden="true">✧</span>
                <p>
                    Здесь появится подробное описание механики ячейки
                    @if (ViewData["FoxImage"] is string foxUrl)
                        {
                            <img src="@foxUrl" alt="Random fox" style="max-width:300px" />
                        }
                    <strong>@Model.TypeKey</strong>: правила шага, эффекты и подсказки для героя.
                </p>
                <p class="cell-dossier__soon">Страница в подготовке — загляните позже.</p>
            </div>

            <a class="btn-torch cell-dossier__back"
               asp-controller="Maze"
               asp-action="Index">
                ← К лабиринту
            </a>
        </div>
    </article>
</div>

<partial name="_MazeSprites" />