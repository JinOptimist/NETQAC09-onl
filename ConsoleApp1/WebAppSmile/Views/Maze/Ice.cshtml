@{
    Layout = "_MazeLayout";
    ViewData["Title"] = "Ячейка Ice";
}

<section class="doc">
    <header>
        <h1>Ячейка Ice</h1>
        <p class="lead">Wiki - ячейка льда</p>
    </header>

    <article>
        <div class="embed-responsive" style="width:50%;margin:0 auto;position:relative;padding-bottom:56.25%;height:0;overflow:hidden;">
            <div id="ice-player" style="position:absolute;top:0;left:0;width:100%;height:100%;"></div>
            <button id="ice-unmute-btn" class="btn btn-secondary" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:2;">Включить звук</button>
        </div>

        <script>
            (function(){
                var tag = document.createElement('script');
                tag.src = "https://www.youtube.com/iframe_api";
                var firstScriptTag = document.getElementsByTagName('script')[0];
                firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

                var icePlayerInstance = null;
                var unmuteButton = null;

                window.onYouTubeIframeAPIReady = function() {
                    icePlayerInstance = new YT.Player('ice-player', {
                        height: '100%',
                        width: '100%',
                        videoId: 'dQw4w9WgXcQ',
                        playerVars: {
                            autoplay: 1,
                            playsinline: 1,
                            controls: 1,
                            rel: 0
                        },
                        events: {
                            onReady: function(event) {
                                try {
                                    event.target.mute();
                                } catch (e) {}
                                try {
                                    event.target.playVideo();
                                } catch (e) {}

                                unmuteButton = document.getElementById('ice-unmute-btn');
                                if (unmuteButton) {
                                    unmuteButton.addEventListener('click', function(ev){
                                        ev.stopPropagation();
                                        try { icePlayerInstance.unMute(); } catch (e) {}
                                        try { icePlayerInstance.playVideo(); } catch (e) {}
                                        unmuteButton.style.display = 'none';
                                    });
                                }

                                var firstGesture = function(){
                                    try { icePlayerInstance.unMute(); } catch (e) {}
                                    try { icePlayerInstance.playVideo(); } catch (e) {}
                                    if (unmuteButton) unmuteButton.style.display = 'none';
                                    document.removeEventListener('click', firstGesture);
                                    document.removeEventListener('keydown', firstGesture);
                                };
                                document.addEventListener('click', firstGesture);
                                document.addEventListener('keydown', firstGesture);
                            }
                        }
                    });
                };
            })();
        </script>

        <h2>Общее</h2>
        <p>Ячейка типа <strong>Ice</strong> представляет собой скользкую поверхность в лабиринте. При попадании на такую ячейку игрок скользии и продолжает движение в том же направлении до тех пор, пока не встретит невскользкую ячейку или препятствие.</p>
    </article>

    <footer>
        <a class="btn-torch" href="@Url.Action("Index","Maze")">Вернуться к лабиринту</a>
    </footer>
</section>
